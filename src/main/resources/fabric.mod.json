{
	"schemaVersion": 1,
	"id": "potion-roulette",
	"version": "${version}",
	"name": "potion-roulette",
	"description": "A Survival challenge where random beneficial and harmful potion effects strike every 60 seconds. Obtain a diamond to win!",
	"authors": [
		"DHANASEKARDHANUSH"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/potion-roulette/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"potion_roulette.PotionRoulette"
		],
		"client": [
			"potion_roulette.client.PotionRouletteClient"
		]
	},
	"mixins": [
		"potion-roulette.mixins.json",
		{
			"config": "potion-roulette.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}